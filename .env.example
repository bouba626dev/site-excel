# Copiez ce fichier en .env et adaptez les valeurs à votre machine.

# Django
SECRET_KEY=changez-moi-par-une-cle-secrete-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : DATABASE_URL est prioritaire en production.
# Exemple : DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/site_excel
DATABASE_URL=

# Alternative locale : sqlite (dev) ou postgresql (production)
DB_ENGINE=sqlite

# PostgreSQL (utilisé uniquement si DB_ENGINE=postgresql)
DB_NAME=site_excel
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
